@inproceedings{xu2026robust,
  selected = {true},
  title = {Robust Wind Power Forecasting via Adversarial State-Space Modeling and Dynamic Mode Decomposition},
  author = {Tao Xu* and Ruiya Qi and Yuyi Zhang},
  booktitle = {International Conference on Knowledge Science, Engineering and Management (KSEM 2026)},
  year = {2026},
  month = jul,
  pages = {73--82},
  volume = {16637},
  series = {Lecture Notes in Computer Science},
  publisher = {Springer},
  doi = {10.1007/978-981-92-2868-3_6},
  urldate = {2026-02-25},
  abstract = {Time series forecasting in renewable energy, particularly wind power prediction, is challenged by non-stationarity, distribution shifts, and complex temporal dependencies. We propose a hybrid forecasting framework that combines deep sequence modeling with adversarial learning and physics-inspired error correction. The model captures both short- and long-term dependencies, integrates contextual meteorological signals, and refines predictions through residual decomposition. Extensive experiments on wind power forecasting tasks demonstrate that our approach achieves significant improvements in RMSE and MAE over classical baselines, highlighting its effectiveness for real-world temporal sequence prediction.},
  description = {A robust wind power forecasting framework combining adversarial state-space modeling with dynamic mode decomposition for accurate predictions.},
  keywords = {Wind power forecasting, State-space modeling, Dynamic mode decomposition},
  preview = {KSEM2026.png}
}

@inproceedings{tao2025fdmamba,
  selected = {true},
  title = {FDMamba-Net: Feature-Decoupled Mamba Network for Efficient Flight Trajectory Prediction},
  author = {Jun Tao and Tao Xu and Jinyang Fang and Jingyuan Xu and Yiming Liu and Yixiao Liu},
  booktitle = {Advanced Intelligent Computing Technology and Applications (ICIC 2025)},
  year = {2025},
  month = jul,
  pages = {460--471},
  publisher = {Springer},
  address = {Singapore},
  series = {Communications in Computer and Information Science (CCIS)},
  volume = {2567},
  doi = {10.1007/978-981-96-9952-0_39},
  urldate = {2026-02-25},
  abstract = {Accurate flight trajectory forecasting is crucial for air traffic management and UAV navigation. However, the task is highly challenging due to complex spatiotemporal dependencies in long sequences and computational constraints. Thus, we propose FDMamba-Net, a novel deep learning-based framework for trajectory prediction that achieves both high efficiency and precision. It combines feature decoupling, spatiotemporal attention fusion, state-space modeling, and spatial-enhanced decoding. The framework first uses a feature decoupling module to divide raw inputs into independent subspaces to eliminate feature interference. Then, spatiotemporal attention fusion is applied to model dynamic temporal relationships. Next, multi-layer Mamba blocks conduct multi-scale temporal modeling. Finally, spatial features are optimized through adaptive weight-enhanced decoding. Experiments show that FDMamba-Net surpasses baseline methods. Compared to Transformer-based approaches, it achieves better performance with 55.5% fewer parameters, making it a promising solution for efficient trajectory prediction.},
  description = {A novel deep learning framework combining feature decoupling, spatiotemporal attention fusion, Mamba blocks and spatial-enhanced decoding for efficient and precise flight trajectory prediction.},
  keywords = {Flight trajectory prediction, Spatiotemporal Modeling, Mamba},
  preview = {FDMamba.png}
}

@inproceedings{liu2025multitask,
  selected = {true},
  title = {Multi-task Driven ResNet-Transformer Framework for Wind Power Forecasting with Dynamic Mode Decomposition Correction},
  author = {Yiming Liu and Wei Li and Ran Ran and Yongqi Wang and Tao Xu and Jun Tao},
  booktitle = {Advanced Intelligent Computing Technology and Applications (ICIC 2025)},
  year = {2025},
  month = jul,
  pages = {458--467},
  publisher = {Springer},
  address = {Singapore},
  series = {Lecture Notes in Computer Science (LNCS)},
  volume = {15849},
  doi = {10.1007/978-981-96-9881-3_38},
  urldate = {2026-02-25},
  abstract = {Wind power generation, as one of the most critical clean energy sources and substitutes for fossil fuels, constitutes a pivotal component in achieving carbon neutrality. In power dispatch operations, the efficiency and accuracy of wind power forecasting serve as the most crucial and influential factors for grid management and operational decision-making. Current wind power prediction methodologies predominantly rely on historical single data source, while suffering from accumulating errors over extended forecasting horizons, leading to significant degradation in prediction accuracy that fails to meet grid scheduling requirements. To address the challenges of temporal dependency and error accumulation in wind power forecasting, we propose a deep learning framework based on multi-task dynamic learning and error correction. The model employs a ResNet-Transformer hybrid architecture, where Temporal Convolutional Networks (TCN) extract localized temporal features, while Transformer encoders capture long-term temporal dependencies through self-attention mechanisms, enhanced by residual connections for hierarchical feature reuse. Experimental validation on real-world wind farm datasets demonstrates that the calibrated predictions achieve a 45.686% RMSE reduction, evidencing the method's effectiveness under complex meteorological conditions. Comparative analyses further reveal substantial improvements in both short-term (<6 h) and extended-range (>24 h) forecasting performance compared to conventional baselines, establishing technical advantages for practical grid integration applications.},
  description = {A ResNet-Transformer hybrid framework with multi-task learning and dynamic mode decomposition correction for accurate wind power forecasting.},
  keywords = {Wind power forecasting, Asymmetric history-future stacking, Multi-source meteorological data fusion, Error propagation mitigation},
  preview = {ResNet-Transformer.png}
}
